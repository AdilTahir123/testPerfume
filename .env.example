# Local database file. For the live site use Turso:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="..."
DATABASE_URL="file:local.db"
# Long random text used to sign login cookies (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=""
# The first admin account, created by npm run db:seed. Use a strong password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Shop contact details shown on the site. Leave empty to hide.
NEXT_PUBLIC_WHATSAPP="923087475047"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_FACEBOOK=""
# The real web address of the live site, used for Google and link previews
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Order emails (optional). Make a free account at resend.com
RESEND_API_KEY=""
EMAIL_FROM="HAAD Fragrances <orders@your-domain.com>"
ORDER_NOTIFY_EMAIL=""
# Live site only: permanent storage for photos uploaded in the admin (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Every order is sent to this WhatsApp number (digits, country code first)
ORDER_WHATSAPP="923087475047"
# Automatic WhatsApp alert: see README "WhatsApp orders" (free CallMeBot key)
CALLMEBOT_APIKEY=""

# ---- Payments (all optional; a method stays "Not available yet" until its values are filled in) ----
# Meezan Bank transfer: shown to customers at checkout. Fill in the REAL account only.
BANK_NAME="Meezan Bank"
BANK_ACCOUNT_TITLE=""
BANK_ACCOUNT_NUMBER=""
BANK_IBAN=""
# JazzCash merchant credentials (from JazzCash). Use JAZZCASH_MODE="sandbox" until they approve you for live.
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_MODE="sandbox"
# Easypaisa merchant credentials (from Easypaisa)
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_MODE="sandbox"
# Optional override of the JazzCash server-to-server inquiry URL (defaults to the sandbox/live address by mode)
JAZZCASH_INQUIRY_URL=""
